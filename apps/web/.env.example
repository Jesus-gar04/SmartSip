# Copia este archivo como .env.local y llena los valores desde
# Firebase → Configuración del proyecto → Tus apps → SmartSip Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Avisos (Web Push). Genera el par con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# En Vercel: las tres como variables de entorno (la privada solo ahí).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
